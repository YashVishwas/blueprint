# Required — raises GitHub API rate limit from 60 to 5000 req/hr
GITHUB_TOKEN=ghp_your_token_here

# Optional — needed for AI narration mode; offline mode works without it
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Cache driver: 'sqlite' (local dev) or 'upstash' (deployed)
CACHE_DRIVER=sqlite

# Required only when CACHE_DRIVER=upstash
# UPSTASH_REDIS_REST_URL=https://your-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# Optional: custom SQLite path (default: .blueprint-cache.db in project root)
# SQLITE_PATH=/tmp/blueprint-cache.db
